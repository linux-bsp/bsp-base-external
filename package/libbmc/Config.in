config BR2_PACKAGE_LIBBMC
	bool "libbmc"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_MMU
	depends on !BR2_STATIC_LIBS
	help
	  Standalone BMC client library with Redfish, IPMI and PMCP backends.
	  Installs libbmc.so and the bmc/bmc.h public header.

if BR2_PACKAGE_LIBBMC

config BR2_PACKAGE_LIBBMC_COLLECTOR
	bool "periodic collector"
	default y
	help
	  Build the optional bounded periodic collection scheduler. Disable this
	  when only synchronous collection and snapshot APIs are required.

config BR2_PACKAGE_LIBBMC_REDFISH
	bool "Redfish backend"
	default y
	select BR2_PACKAGE_CJSON
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBCURL_FORCE_TLS
	select BR2_PACKAGE_LIBCURL_OPENSSL
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_OPENSSL_FORCE_LIBOPENSSL

config BR2_PACKAGE_LIBBMC_IPMI
	bool "IPMI backend"
	select BR2_PACKAGE_FREEIPMI
	select BR2_PACKAGE_LIBGCRYPT if BR2_PACKAGE_LIBGPG_ERROR_ARCH_SUPPORTS

config BR2_PACKAGE_LIBBMC_PMCP
	bool "PMCP backend"

endif
