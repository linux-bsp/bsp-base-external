config BR2_PACKAGE_DEVICE_MANAGER
    bool "Device Manager device tools"
    depends on BR2_USE_MMU
    help
      Select the firmware and logging tools installed on the device.
      The host tools are selected independently below.

if BR2_PACKAGE_DEVICE_MANAGER

config BR2_PACKAGE_DEVICE_MANAGER_FWCTL
    bool "fwctl firmware management"
    depends on BR2_TOOLCHAIN_HAS_THREADS
    select BR2_PACKAGE_CA_CERTIFICATES
    select BR2_PACKAGE_DTC
    select BR2_PACKAGE_LIBCURL
    select BR2_PACKAGE_LIBCURL_EXTRA_PROTOCOLS_FEATURES
    select BR2_PACKAGE_LIBCURL_FORCE_TLS
    select BR2_PACKAGE_LIBCURL_OPENSSL
    select BR2_PACKAGE_OPENSSL
    select BR2_PACKAGE_OPENSSL_FORCE_LIBOPENSSL
    help
      Install the standalone RAW A/B firmware controller and health checks.

config BR2_PACKAGE_DEVICE_MANAGER_FWCTLD
    bool "fwctld OTA agent"
    depends on BR2_PACKAGE_DEVICE_MANAGER_FWCTL
    select BR2_PACKAGE_LIBCURL_CURL
    help
      Install the OTA polling, download, installation and reporting daemon.
      Requires sha256sum in BusyBox for firmware validation.

config BR2_PACKAGE_DEVICE_MANAGER_LOGCTL
    bool "logctl / logctld boot logs"
    select BR2_PACKAGE_LIBCURL
    select BR2_PACKAGE_CA_CERTIFICATES
    help
      Install bounded per-boot logging and optional HTTP(S) forwarding.
      Existing storage is mounted but never formatted during boot.

config BR2_PACKAGE_DEVICE_MANAGER_FWCTL_FIT_SIGNATURE
    bool "fwctl FIT signature verifier"
    depends on BR2_PACKAGE_DEVICE_MANAGER_FWCTL
    select BR2_PACKAGE_UBOOT_TOOLS
    select BR2_PACKAGE_UBOOT_TOOLS_FIT_SUPPORT
    select BR2_PACKAGE_UBOOT_TOOLS_FIT_SIGNATURE_SUPPORT
    select BR2_PACKAGE_UBOOT_TOOLS_FIT_CHECK_SIGN

endif
