# Configure the LAN server before enabling. Transaction state is stored on the server.
FWCTLD_ENABLED=0
FWCTLD_SERVER=""
FWCTLD_PRODUCT="ti-am62x"
FWCTLD_LAYOUT="am62x-sd-ab-v1"
FWCTLD_CACHE="/data/fwctld"
FWCTLD_INTERVAL=60
# Once enabled, automatically install newer releases and reboot.
FWCTLD_AUTO_INSTALL=1
# Empty: derive the stable device ID from eth0 MAC (colon replaced by hyphen).
FWCTLD_DEVICE_ID=""

# Mirror upgrade stages to the serial console; empty disables the mirror.
FWCTLD_CONSOLE="/dev/console"

# Wait for this interface to have link and IP before OTA requests.
# Empty disables the local gate (for custom/multiple-interface routing).
FWCTLD_INTERFACE="eth0"
