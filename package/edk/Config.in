config BR2_PACKAGE_EDK
	bool "edk"
	depends on BR2_LINUX_KERNEL
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_MMU
	help
	  EDK is a Linux embedded device kit with a
	  Kconfig+CMake/Kbuild build system. It provides the PDM kernel
	  module, the shared PDI userspace library, UAPI headers, and
	  optional PDI tools such as pdebug and pdi_claim_test.

if BR2_PACKAGE_EDK

config BR2_PACKAGE_EDK_DEFCONFIG
	string "Kconfig defconfig to use"
	default ""
	help
	  Specify which EDK defconfig to load before building.
	  Product external trees should set this to a product-specific
	  EDK defconfig, for example ti_am62x_defconfig. Debug
	  images should use a defconfig that enables CONFIG_PDI,
	  CONFIG_PDEBUG when board-side claim validation is required.

config BR2_PACKAGE_EDK_FW
	bool "Enable EDK host firmware update dependencies"
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_CA_CERTIFICATES
	select BR2_PACKAGE_DTC
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBCURL_EXTRA_PROTOCOLS_FEATURES
	select BR2_PACKAGE_LIBCURL_FORCE_TLS
	select BR2_PACKAGE_LIBCURL_OPENSSL
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_OPENSSL_FORCE_LIBOPENSSL
	help
	  Select this when the EDK defconfig enables CONFIG_EDK_FW. It provides
	  libfdt, libcurl, and OpenSSL for the host A/B firmware API in
	  libedk_firmware.so. CONFIG_FWCTL may additionally enable the command-line
	  adapter, but it does not own these implementation dependencies.

config BR2_PACKAGE_EDK_FW_FIT_SIGNATURE
	bool "Install EDK firmware FIT signature verifier"
	depends on BR2_PACKAGE_EDK_FW
	select BR2_PACKAGE_UBOOT_TOOLS
	select BR2_PACKAGE_UBOOT_TOOLS_FIT_SUPPORT
	select BR2_PACKAGE_UBOOT_TOOLS_FIT_SIGNATURE_SUPPORT
	select BR2_PACKAGE_UBOOT_TOOLS_FIT_CHECK_SIGN
	help
	  Install fit_check_sign for PDI firmware configurations that require
	  FIT signature verification against a trusted key DTB.


choice
	prompt "Build type"
	default BR2_PACKAGE_EDK_BUILD_TYPE_RELEASE

config BR2_PACKAGE_EDK_BUILD_TYPE_RELEASE
	bool "Release"

config BR2_PACKAGE_EDK_BUILD_TYPE_DEBUG
	bool "Debug"

config BR2_PACKAGE_EDK_BUILD_TYPE_RELWITHDEBINFO
	bool "RelWithDebInfo"

endchoice

config BR2_PACKAGE_EDK_BUILD_TYPE
	string
	default "Release" if BR2_PACKAGE_EDK_BUILD_TYPE_RELEASE
	default "Debug" if BR2_PACKAGE_EDK_BUILD_TYPE_DEBUG
	default "RelWithDebInfo" if BR2_PACKAGE_EDK_BUILD_TYPE_RELWITHDEBINFO

config BR2_PACKAGE_EDK_INSTALL_HEADERS
	bool "Install development headers"
	default n
	help
	  Install development headers to $(STAGING_DIR)/usr/include/.
	  Only needed for packages that depend on EDK.

endif # BR2_PACKAGE_EDK

comment "EDK needs Linux kernel and a toolchain w/ threads, MMU"
	depends on !BR2_LINUX_KERNEL || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_USE_MMU
