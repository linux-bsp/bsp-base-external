config BR2_PACKAGE_HOST_EDK
    bool "host Device Manager tools"
    help
      Select tools built for the development host from the same source.

if BR2_PACKAGE_HOST_EDK

config BR2_PACKAGE_HOST_EDK_DMSERVER
    bool "dmserver"
    default y
    help
      Install the Device Manager Web and OTA server to host/bin.

config BR2_PACKAGE_HOST_EDK_DMCLI
    bool "dmcli"
    default y
    help
      Install dmcli with OTA upload, publication and query subcommands to host/bin.

endif
