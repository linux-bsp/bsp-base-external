config BR2_PACKAGE_FWCTLD
	bool "fwctld"
	depends on BR2_USE_MMU
	depends on BR2_PACKAGE_EDK_FW
	select BR2_PACKAGE_LIBCURL_CURL
	help
	  C firmware daemon for BSP OTA publications. Downloads and verifies
	  releases, optionally invokes fwctl to install and reboot, and reports
	  boot health results. Requires sha256sum (enabled in the AM62x
	  BusyBox config). Configure /etc/default/fwctld.
