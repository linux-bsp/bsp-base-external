cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/../../../edk/scripts/cmake/build_info.cmake")
get_filename_component(workspace "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(sources "{}")
foreach(name . edk bsp-base-external buildroot linux/linux-7.0 uboot/u-boot-2026.04 libbmc)
    edk_source_info("${workspace}/${name}" record)
    string(JSON sources SET "${sources}" "${name}" "${record}")
endforeach()
set(paths "${DECLARATION}")
set(keys firmware)
if(EXISTS "$ENV{BR2_CONFIG}")
    list(APPEND paths "$ENV{BR2_CONFIG}")
    list(APPEND keys buildroot)
endif()
if(VERSION_FILE)
    list(APPEND paths "${VERSION_FILE}")
    list(APPEND keys edk_version)
endif()
set(packages "{}")
foreach(name edk host-edk)
    file(GLOB infos "${BUILD_DIR}/${name}-*/buildroot-build/build-info.json")
    list(LENGTH infos count)
    if(count GREATER 1)
        message(FATAL_ERROR "Ambiguous ${name} build information")
    endif()
    foreach(info IN LISTS infos)
        file(READ "${info}" data)
        string(JSON packages SET "${packages}" "${name}" "${data}")
        get_filename_component(folder "${info}" DIRECTORY)
        list(APPEND paths "${folder}/.config")
        list(APPEND keys "${name}")
    endforeach()
endforeach()
foreach(name linux uboot ti-k3-r5-loader)
    file(GLOB configs "${BUILD_DIR}/${name}-*/.config")
    list(LENGTH configs count)
    if(count GREATER 1)
        message(FATAL_ERROR "Ambiguous ${name} build configuration")
    endif()
    foreach(path IN LISTS configs)
        list(APPEND paths "${path}")
        list(APPEND keys "${name}")
    endforeach()
endforeach()
set(checksums "{}")
list(LENGTH paths count)
math(EXPR last "${count}-1")
foreach(index RANGE ${last})
    list(GET paths ${index} path)
    list(GET keys ${index} key)
    file(SHA256 "${path}" digest)
    string(JSON checksums SET "${checksums}" "${key}" "\"${digest}\"")
endforeach()
set(tools "{}")
foreach(name cmake mkimage dtc)
    set(option --version)
    if(name STREQUAL mkimage)
        set(option -V)
    endif()
    execute_process(COMMAND "${HOST_DIR}/bin/${name}" "${option}" OUTPUT_VARIABLE stdout
        ERROR_VARIABLE stderr COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCH "^[^\n]*" version "${stdout}${stderr}")
    edk_json_quote("${version}" quoted)
    string(JSON tools SET "${tools}" "${name}" "${quoted}")
endforeach()
file(READ "${IMAGES}/firmware-identity.json" identity)
if(VERSION_FILE)
    string(JSON expected GET "${identity}" tag)
    string(SUBSTRING "${expected}" 1 -1 expected)
    string(JSON count LENGTH "${packages}")
    if(count GREATER 0)
        math(EXPR last "${count}-1")
        foreach(index RANGE ${last})
            string(JSON name MEMBER "${packages}" ${index})
            string(JSON actual GET "${packages}" "${name}" version)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "${name} version differs from firmware; rebuild ${name}")
            endif()
        endforeach()
    endif()
endif()
file(WRITE "${IMAGES}/build-manifest.json" "{\"schema_version\":1,\"source_date_epoch\":${EPOCH},\"identity\":${identity},\"sources\":${sources},\"configuration_sha256\":${checksums},\"packages\":${packages},\"tools\":${tools}}\n")
