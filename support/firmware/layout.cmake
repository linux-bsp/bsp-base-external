cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/../../../edk/scripts/cmake/build_info.cmake")
file(READ "${CONFIG}" declaration)
get_filename_component(board "${DECLARATION}" DIRECTORY)
set(regions meta0 meta1 tiboot3_a tiboot3_b tispl_a tispl_b uboot_a uboot_b kernel_a kernel_b rootfs_a rootfs_b)

function(quantity input out)
    if(NOT input MATCHES "^(0[xX][0-9a-fA-F]+|[0-9]+)([KMG]?)$")
        message(FATAL_ERROR "Invalid layout quantity: ${input}")
    endif()
    set(number "${CMAKE_MATCH_1}")
    set(unit "${CMAKE_MATCH_2}")
    set(scale 1)
    foreach(letter K M G)
        if(unit STREQUAL letter)
            if(letter STREQUAL K)
                set(scale 1024)
            elseif(letter STREQUAL M)
                set(scale 1048576)
            else()
                set(scale 1073741824)
            endif()
        endif()
    endforeach()
    math(EXPR value "${number} * ${scale}")
    if(value LESS 0)
        message(FATAL_ERROR "Layout quantity overflow: ${input}")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(read_values path prefix)
    file(STRINGS "${path}" lines)
    set(keys)
    foreach(line IN LISTS lines)
        if(line MATCHES "^[ \t]*#" OR NOT line MATCHES "^([^=]+)=(.*)$")
            continue()
        endif()
        string(STRIP "${CMAKE_MATCH_1}" key)
        string(STRIP "${CMAKE_MATCH_2}" value)
        if(key IN_LIST keys AND NOT "${seen_${key}}" STREQUAL value)
            message(FATAL_ERROR "Conflicting duplicate ${key} in ${path}")
        endif()
        list(APPEND keys "${key}")
        set("seen_${key}" "${value}")
        set("${prefix}_${key}" "${value}" PARENT_SCOPE)
    endforeach()
endfunction()

function(set_region table name start size out)
    string(JSON previous ERROR_VARIABLE found GET "${table}" "${name}")
    if(NOT found)
        message(FATAL_ERROR "Duplicate layout region: ${name}")
    endif()
    string(JSON table SET "${table}" "${name}" "{\"offset\":${start},\"size\":${size}}")
    set(${out} "${table}" PARENT_SCOPE)
endfunction()

function(check_regions table)
    string(JSON count LENGTH "${table}")
    math(EXPR last "${count}-1")
    foreach(index RANGE ${last})
        string(JSON name MEMBER "${table}" ${index})
        string(JSON start GET "${table}" "${name}" offset)
        string(JSON size GET "${table}" "${name}" size)
        math(EXPR end "${start}+${size}")
        math(EXPR aligned "(${start}%512)+(${size}%512)")
        if(size LESS_EQUAL 0 OR end LESS_EQUAL start OR aligned)
            message(FATAL_ERROR "Invalid, overflowing or unaligned region: ${name}")
        endif()
        foreach(other RANGE ${last})
            if(other GREATER_EQUAL index)
                continue()
            endif()
            string(JSON previous MEMBER "${table}" ${other})
            string(JSON other_start GET "${table}" "${previous}" offset)
            string(JSON other_size GET "${table}" "${previous}" size)
            math(EXPR other_end "${other_start}+${other_size}")
            if(start LESS other_end AND other_start LESS end)
                message(FATAL_ERROR "Overlapping regions: ${name}, ${previous}")
            endif()
        endforeach()
    endforeach()
endfunction()

function(expect_region table name start size)
    string(JSON actual_start GET "${table}" "${name}" offset)
    string(JSON actual_size GET "${table}" "${name}" size)
    if(NOT actual_start EQUAL start OR NOT actual_size EQUAL size)
        message(FATAL_ERROR "Layout mismatch in ${name}: ${actual_start}/${actual_size}, expected ${start}/${size}")
    endif()
endfunction()

function(prop dtb node key type out)
    if(NOT EXISTS "${dtb}")
        message(FATAL_ERROR "Missing U-Boot DTB build dependency: ${dtb}")
    endif()
    execute_process(COMMAND "${HOST_DIR}/bin/fdtget" -t "${type}" "${dtb}" "${node}" "${key}"
        OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

string(JSON linux_relative GET "${declaration}" validation linux_layout)
string(JSON factory_relative GET "${declaration}" factory layout)
string(JSON env_relative GET "${declaration}" factory environment)
set(linux_path "${board}/${linux_relative}")
set(factory_path "${board}/${factory_relative}")
set(env_path "${TARGET_DIR}/${env_relative}")
set(installed_path "${TARGET_DIR}/etc/device-manager/firmware.conf")
read_values("${linux_path}" linux)
read_values("${installed_path}" installed)
read_values("${env_path}" env)
set(expected "{}")
foreach(name IN LISTS regions)
    quantity("${linux_${name}-offset}" start)
    quantity("${linux_${name}-size}" size)
    set_region("${expected}" "${name}" "${start}" "${size}" expected)
    quantity("${installed_${name}-offset}" actual_start)
    quantity("${installed_${name}-size}" actual_size)
    if(NOT actual_start EQUAL start OR NOT actual_size EQUAL size)
        message(FATAL_ERROR "Installed Linux region differs: ${name}")
    endif()
endforeach()
check_regions("${expected}")
foreach(key device storage-type hwid-config)
    if(NOT "${linux_${key}}" STREQUAL "${installed_${key}}")
        message(FATAL_ERROR "Installed firmware configuration differs: ${key}")
    endif()
endforeach()
foreach(name tiboot3 tispl uboot kernel rootfs)
    string(JSON a GET "${expected}" "${name}_a" size)
    string(JSON b GET "${expected}" "${name}_b" size)
    if(NOT a EQUAL b)
        message(FATAL_ERROR "A/B capacities differ: ${name}")
    endif()
endforeach()
file(READ "${factory_path}" factory_text)
string(REGEX REPLACE "\\$\\{[^}]+\\}" "IMAGE" factory_text "${factory_text}")
string(REGEX REPLACE "#[^\n]*" "" factory_text "${factory_text}")
if(NOT factory_text MATCHES "partition-table-type[ \t]*=[ \t]*\"none\"")
    message(FATAL_ERROR "Expected explicit RAW factory layout")
endif()
string(REGEX MATCHALL "partition[ \t]+[A-Za-z0-9_]+[ \t\r\n]*\\{[^}]*\\}" partitions "${factory_text}")
set(factory "{}")
foreach(partition IN LISTS partitions)
    string(REGEX MATCH "partition[ \t]+([A-Za-z0-9_]+)" matched "${partition}")
    set(name "${CMAKE_MATCH_1}")
    foreach(key offset size)
        string(REGEX MATCHALL "[\n{][ \t]*${key}[ \t]*=[ \t]*[^ \t\r\n]+" matches "${partition}")
        list(LENGTH matches count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Factory ${name} requires explicit ${key}")
        endif()
        string(REGEX REPLACE ".*=[ \t]*" "" raw "${matches}")
        quantity("${raw}" "${key}")
    endforeach()
    set_region("${factory}" "${name}" "${offset}" "${size}" factory)
endforeach()
check_regions("${factory}")
set(parts "${env_fw_parts_a},${env_fw_parts_b},${env_fw_parts_os}")
string(REPLACE "," ";" parts "${parts}")
set(boot "{}")
set(cursor 0)
list(LENGTH parts total)
set(index 0)
foreach(part IN LISTS parts)
    math(EXPR index "${index}+1")
    if(NOT part MATCHES "^(-|[0-9xXa-fA-F]+[KMG]?)(@([0-9xXa-fA-F]+[KMG]?))?\\(([A-Za-z0-9_]+)\\)$")
        message(FATAL_ERROR "Invalid blkdevparts entry: ${part}")
    endif()
    set(raw_size "${CMAKE_MATCH_1}")
    set(raw_start "${CMAKE_MATCH_3}")
    set(name "${CMAKE_MATCH_4}")
    set(start "${cursor}")
    if(raw_start)
        quantity("${raw_start}" start)
    endif()
    if(start LESS cursor)
        message(FATAL_ERROR "Overlapping blkdevparts: ${name}")
    endif()
    if(raw_size STREQUAL "-")
        if(NOT index EQUAL total)
            message(FATAL_ERROR "Remaining partition must be last")
        endif()
        set(size null)
    else()
        quantity("${raw_size}" size)
        math(EXPR cursor "${start}+${size}")
        math(EXPR aligned "(${start}%512)+(${size}%512)")
        if(size LESS_EQUAL 0 OR cursor LESS_EQUAL start OR aligned)
            message(FATAL_ERROR "Invalid blkdevparts geometry: ${name}")
        endif()
    endif()
    set_region("${boot}" "${name}" "${start}" "${size}" boot)
endforeach()
set(sources "${linux_path}" "${factory_path}" "${env_path}" "${installed_path}")
string(JSON dtb_count LENGTH "${declaration}" validation uboot_dtbs)
math(EXPR last "${dtb_count}-1")
foreach(index RANGE ${last})
    string(JSON relative GET "${declaration}" validation uboot_dtbs ${index})
    set(dtb "${BUILD_DIR}/${relative}")
    list(APPEND sources "${dtb}")
    prop("${dtb}" /firmware-manager storage s storage)
    prop("${dtb}" /firmware-manager device u device)
    if(NOT storage STREQUAL mmc OR NOT linux_storage-type STREQUAL block OR
            NOT env_fw_mmcdev STREQUAL device OR NOT linux_device STREQUAL "/dev/mmcblk${device}")
        message(FATAL_ERROR "Linux/U-Boot RAW MMC device mismatch")
    endif()
    foreach(name IN LISTS regions)
        foreach(key offset size)
            prop("${dtb}" "/firmware-manager/${name}" "${key}" u cells)
            string(REPLACE " " ";" cells "${cells}")
            list(LENGTH cells count)
            if(NOT count EQUAL 2)
                message(FATAL_ERROR "Expected two DTB geometry cells")
            endif()
            list(GET cells 0 high)
            list(GET cells 1 low)
            math(EXPR "${key}" "${high}*4294967296+${low}")
            string(JSON expected_value GET "${expected}" "${name}" "${key}")
            if(NOT "${${key}}" EQUAL expected_value)
                message(FATAL_ERROR "U-Boot DTB ${name}/${key} differs from Linux")
            endif()
        endforeach()
        expect_region("${boot}" "${name}" "${offset}" "${size}")
        expect_region("${factory}" "${name}" "${offset}" "${size}")
    endforeach()
    get_filename_component(directory "${dtb}" DIRECTORY)
    set(kconfig "${directory}/.config")
    read_values("${kconfig}" kconf)
    list(APPEND sources "${kconfig}")
    if(NOT kconf_CONFIG_ENV_IS_IN_MMC STREQUAL y OR NOT kconf_CONFIG_ENV_MMC_EMMC_HW_PARTITION STREQUAL "0" OR
            NOT kconf_CONFIG_ENV_MMC_DEVICE_INDEX STREQUAL env_fw_mmcdev)
        message(FATAL_ERROR "Unsupported MMC environment backing in ${kconfig}")
    endif()
    foreach(key ENV_MMC_USE_DT ENV_MMC_USE_SW_PARTITION ENV_OFFSET_RELATIVE_END ENV_OFFSET_REDUND_RELATIVE_END)
        if("${kconf_CONFIG_${key}}" STREQUAL y)
            message(FATAL_ERROR "Unsupported environment offset policy: ${key}")
        endif()
    endforeach()
    quantity("${kconf_CONFIG_ENV_SIZE}" env_size)
    quantity("${kconf_CONFIG_ENV_OFFSET}" env0)
    quantity("${kconf_CONFIG_ENV_OFFSET_REDUND}" env1)
    expect_region("${factory}" uboot_env0 "${env0}" "${env_size}")
    expect_region("${factory}" uboot_env1 "${env1}" "${env_size}")
endforeach()
string(JSON area_start GET "${boot}" env_area offset)
string(JSON area_size GET "${boot}" env_area size)
math(EXPR area_end "${area_start}+${area_size}")
foreach(name uboot_env0 uboot_env1)
    string(JSON start GET "${factory}" "${name}" offset)
    string(JSON size GET "${factory}" "${name}" size)
    math(EXPR end "${start}+${size}")
    if(start LESS area_start OR end GREATER area_end)
        message(FATAL_ERROR "Environment exceeds reserved env_area")
    endif()
endforeach()
string(JSON data_start GET "${factory}" data offset)
string(JSON boot_data GET "${boot}" data offset)
if(NOT data_start EQUAL boot_data)
    message(FATAL_ERROR "Factory and blkdevparts data offsets differ")
endif()
set(env_config "${TARGET_DIR}${linux_hwid-config}")
file(STRINGS "${env_config}" lines)
set(locations)
foreach(line IN LISTS lines)
    string(STRIP "${line}" line)
    if(NOT line OR line MATCHES "^#")
        continue()
    endif()
    separate_arguments(fields UNIX_COMMAND "${line}")
    list(LENGTH fields count)
    if(NOT count EQUAL 3)
        message(FATAL_ERROR "Unsupported fw_env.config fields")
    endif()
    list(GET fields 0 device)
    list(GET fields 1 raw)
    quantity("${raw}" start)
    list(GET fields 2 raw)
    quantity("${raw}" size)
    if(NOT device STREQUAL linux_device OR NOT size EQUAL env_size)
        message(FATAL_ERROR "HWID environment device or size differs")
    endif()
    list(APPEND locations "${start}")
endforeach()
list(SORT locations COMPARE NATURAL)
set(expected_locations "${env0};${env1}")
list(SORT expected_locations COMPARE NATURAL)
if(NOT locations STREQUAL expected_locations)
    message(FATAL_ERROR "HWID environment locations differ")
endif()
list(APPEND sources "${env_config}")
string(JSON hwids GET "${declaration}" hwids)
edk_json_quote("${env_hwid}" quoted)
string(FIND "${hwids}" "${quoted}" found)
if(found LESS 0)
    message(FATAL_ERROR "Factory HWID absent from firmware allowlist")
endif()
foreach(name tiboot3 tispl uboot kernel rootfs)
    if(name STREQUAL kernel)
        string(JSON limit GET "${declaration}" components kernel max_size)
    elseif(name STREQUAL rootfs)
        string(JSON limit GET "${declaration}" components rootfs images 0 max_size)
    else()
        string(JSON images_count LENGTH "${declaration}" components bootloader images)
        math(EXPR last "${images_count}-1")
        set(limit "")
        foreach(index RANGE ${last})
            string(JSON key GET "${declaration}" components bootloader images ${index} name)
            if(key STREQUAL name)
                string(JSON limit GET "${declaration}" components bootloader images ${index} max_size)
            endif()
        endforeach()
    endif()
    string(JSON capacity GET "${expected}" "${name}_a" size)
    if(NOT limit OR limit GREATER capacity)
        message(FATAL_ERROR "Explicit ${name} max_size exceeds slot capacity")
    endif()
endforeach()
set(checksums "{}")
foreach(path IN LISTS sources)
    file(SHA256 "${path}" hash)
    string(JSON checksums SET "${checksums}" "${path}" "\"${hash}\"")
endforeach()
file(WRITE "${OUTPUT}" "{\"schema_version\":1,\"result\":\"consistent\",\"regions\":${expected},\"sources\":${checksums}}\n")
