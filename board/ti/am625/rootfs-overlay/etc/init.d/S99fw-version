#!/bin/sh

# Diagnostic output only: never update metadata or gate boot confirmation.
[ -r /etc/default/fwctl ] && . /etc/default/fwctl

case "$1" in
    start|restart|reload)
        if ! /usr/sbin/fwctl --config "${FWCTL_CONFIG:-/etc/edk/firmware.conf}" version; then
            echo "fwctl: running firmware version unavailable" >&2
        fi
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload}" >&2
        exit 2
        ;;
esac

exit 0
