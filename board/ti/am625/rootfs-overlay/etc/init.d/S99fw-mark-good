#!/bin/sh

[ -r /etc/default/fwctl ] && . /etc/default/fwctl

PIDFILE=${FWCTL_MARK_GOOD_PIDFILE:-/var/run/fw-mark-good.pid}
OUTPUT=${FWCTL_MARK_GOOD_OUTPUT:-/dev/console}

health_check()
{
	/usr/sbin/fwctl health-check
}

wait_until_stable()
{
	checks=6
	interval=5
	count=0
	attempt=0
	limit=24
	waiting=0

	while [ "$attempt" -lt "$limit" ]; do
		[ "$interval" -eq 0 ] || sleep "$interval"
		attempt=$((attempt + 1))
		health_check > /run/fwctl-health.last 2>&1
		result=$?
		case "$result" in
			0)
				waiting=0
				count=$((count + 1))
				[ "$count" -lt "$checks" ] || return 0
				;;
			75)
				count=0
				if [ "$waiting" -eq 0 ]; then
					cat /run/fwctl-health.last >&2
					waiting=1
				fi
				;;
			*)
				cat /run/fwctl-health.last >&2
				echo "[fwctl] [ERROR] boot health failed" >&2
				return 1
				;;
		esac
	done
	echo "[fwctl] [ERROR] boot health did not stabilize within the observation deadline" >&2
	return 1
}

deployment_is_confirmed()
{
	deployment=$1
	status=$(/usr/sbin/fwctl \
		--config "${FWCTL_CONFIG:-/etc/device-manager/firmware.conf}" status 2>/dev/null) ||
		return 1
	printf '%s\n' "$status" |
		grep -q "^deployment ${deployment}: .* successful=1 "
}

worker_running()
{
	[ -r "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	case "$pid" in
		''|*[!0-9]*) return 1 ;;
	esac
	kill -0 "$pid" 2>/dev/null
}

record_boot_event()
{
    [ ! -x /usr/sbin/logctl ] || /usr/sbin/logctl boot-event "$1" ||
        echo "[fwctl] [WARN] boot event could not be persisted" >&2
}

record_mark_good_failure()
{
	failure_file=${FWCTL_BOOT_FAILURES:-/run/rcS.critical}
	failure="S99fw-mark-good:1"
	grep -qx "$failure" "$failure_file" 2>/dev/null ||
		printf '%s\n' "$failure" >> "$failure_file"
}

mark_good_worker()
{
	deployment=$1
	trap 'rm -f "$PIDFILE"' EXIT
	trap 'exit 0' HUP INT TERM

	if ! wait_until_stable; then
		record_mark_good_failure
		status=$(/usr/sbin/fwctl --config "${FWCTL_CONFIG:-/etc/device-manager/firmware.conf}" status 2>/dev/null)
		if printf '%s\n' "$status" | grep -q "^active: .* pending: ${deployment} "; then
			if /usr/sbin/fwctl --config "${FWCTL_CONFIG:-/etc/device-manager/firmware.conf}" mark-bad "$deployment"; then
				echo "[fwctl] [ERROR] candidate rejected by boot health; rebooting to the confirmed deployment" >&2
				record_boot_event health-rejected
				sync
				reboot
			fi
		fi
		return 1
	fi
	if deployment_is_confirmed "$deployment"; then
		printf '%s\n' "$deployment" > /run/fwctl-boot-confirmed
		record_boot_event health-confirmed
		/usr/sbin/fwctl recovery maintain
		return 0
	fi
	if /usr/sbin/fwctl \
		--config "${FWCTL_CONFIG:-/etc/device-manager/firmware.conf}" \
		mark-good; then
		printf '%s\n' "$deployment" > /run/fwctl-boot-confirmed
		echo "[fwctl] [INFO] current deployment marked good"
		record_boot_event health-confirmed
		/usr/sbin/fwctl recovery maintain
		return 0
	fi

	echo "[fwctl] [ERROR] failed to confirm current deployment" >&2
	record_mark_good_failure
	return 1
}

start_worker()
{
	deployment=$1

	if worker_running; then
		echo "[fwctl] [INFO] deployment health monitoring is already running"
		return 0
	fi
	rm -f "$PIDFILE"

	/usr/sbin/logctl run services "$0" worker "$deployment" >"$OUTPUT" 2>&1 &
	worker_pid=$!
	if ! printf '%s\n' "$worker_pid" > "$PIDFILE"; then
		kill "$worker_pid" 2>/dev/null
		echo "[fwctl] [ERROR] failed to create background worker pid file" >&2
		return 1
	fi
	if ! kill -0 "$worker_pid" 2>/dev/null; then
		rm -f "$PIDFILE"
		echo "[fwctl] [ERROR] failed to start deployment health monitoring" >&2
		return 1
	fi

	echo "[fwctl] [INFO] deployment $deployment health monitoring started in background"
	return 0
}

stop_worker()
{
	if worker_running; then
		pid=$(cat "$PIDFILE")
		kill "$pid" 2>/dev/null || true
	fi
	rm -f "$PIDFILE"
}

case "$1" in
	start)
		[ "${AUTO_MARK_GOOD:-0}" = "1" ] || exit 0
		deployment=$(sed -n 's/.*fw\.deployment=\([01]\).*/\1/p' /proc/cmdline)
		[ -n "$deployment" ] || exit 0
		start_worker "$deployment"
		;;
	stop)
		stop_worker
		;;
	restart|reload)
		stop_worker
		"$0" start
		;;
	worker)
		case "$2" in
			0|1) mark_good_worker "$2" ;;
			*) exit 2 ;;
		esac
		exit $?
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}" >&2
		exit 2
		;;
esac

exit 0
