#!/bin/sh

DAEMON=/usr/sbin/lighttpd
CGI=/usr/libexec/pdebug-web/pdebug.cgi
CONFIG=/etc/lighttpd/lighttpd.conf
PIDFILE=/run/pdebug-web/lighttpd.pid

running()
{
    [ -r "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null
}

start()
{
    printf 'Starting pdebug web (lighttpd): '
    if [ ! -x "$DAEMON" ] || [ ! -x "$CGI" ]; then
        echo 'SKIP (not installed)'
        return 0
    fi
    if running; then
        echo 'already running'
        return 0
    fi
    mkdir -p /var/log
    if ! "$CGI" --init-token || ! "$DAEMON" -tt -f "$CONFIG"; then
        echo 'FAIL (initialization)'
        return 1
    fi
    if ! "$DAEMON" -f "$CONFIG"; then
        echo 'FAIL'
        return 1
    fi
    echo 'OK (port 8080; access key: /run/pdebug-web/token)'
}

stop()
{
    printf 'Stopping pdebug web (lighttpd): '
    if running; then
        pid=$(cat "$PIDFILE")
        kill "$pid" 2>/dev/null || true
        count=0
        while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi
    rm -f "$PIDFILE"
    echo 'OK'
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload) stop && start ;;
    status)
        if running; then echo "pdebug web: running pid $(cat "$PIDFILE")";
        else echo 'pdebug web: stopped'; exit 3; fi
        ;;
    *) echo "Usage: $0 {start|stop|restart|reload|status}" >&2; exit 2 ;;
esac
