#!/bin/sh

DAEMON=/usr/sbin/system_manager
PIDFILE=/run/system_manager.pid
OUTPUT=/var/log/system_manager.log

running()
{
	[ -r "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	case "$pid" in
		''|*[!0-9]*) return 1 ;;
	esac
	kill -0 "$pid" 2>/dev/null
}

start()
{
	printf 'Starting system_manager: '
	if [ ! -x "$DAEMON" ]; then
		echo "SKIP (not installed)"
		return 0
	fi
	if running; then
		echo "already running"
		return 0
	fi
    if [ ! -r /etc/default/boot-health ]; then
        echo "FAIL (missing boot health policy)"
        return 1
    fi
    . /etc/default/boot-health
    if [ "${HEALTH_CRITICAL_SERVICES+x}" != x ]; then
        echo "FAIL (missing critical service policy)"
        return 1
    fi
	rm -f "$PIDFILE"
	"$DAEMON" --critical-services "$HEALTH_CRITICAL_SERVICES" >"$OUTPUT" 2>&1 &
	pid=$!
	if ! printf '%s\n' "$pid" >"$PIDFILE" || ! kill -0 "$pid" 2>/dev/null; then
		rm -f "$PIDFILE"
		echo "FAIL"
		return 1
	fi
	echo "OK"
}

stop()
{
	printf 'Stopping system_manager: '
	if running; then
		pid=$(cat "$PIDFILE")
		kill "$pid" 2>/dev/null || true
		count=0
		while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
			sleep 1
			count=$((count + 1))
		done
		if kill -0 "$pid" 2>/dev/null; then
			kill -9 "$pid" 2>/dev/null || true
			count=0
			while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 3 ]; do
				sleep 1
				count=$((count + 1))
			done
			if kill -0 "$pid" 2>/dev/null; then
				echo "FAIL (process $pid did not exit)"
				return 1
			fi
		fi
	fi
	rm -f "$PIDFILE"
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop && start ;;
	status)
		if running; then
			echo "system_manager: running pid $(cat "$PIDFILE")"
		else
			echo "system_manager: stopped"
			exit 3
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload|status}" >&2
		exit 2
		;;
esac
