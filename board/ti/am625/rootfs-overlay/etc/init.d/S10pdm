#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin

MODULE=pdm
SYS_MODULE=/sys/module/$MODULE
MANAGER_DEVICE=/dev/pdm_manager
CAN_SERVICE=/etc/init.d/S09can

module_loaded()
{
	[ -d "$SYS_MODULE" ]
}

manager_ready()
{
	[ -c "$MANAGER_DEVICE" ]
}

start()
{
	printf 'Starting PDM: '

	if [ ! -x "$CAN_SERVICE" ] || ! "$CAN_SERVICE" status >/dev/null; then
		echo "FAIL (CAN service is not ready)"
		return 1
	fi

	if ! module_loaded && ! modprobe "$MODULE"; then
		echo "FAIL (modprobe $MODULE failed)"
		return 1
	fi

	if ! module_loaded; then
		echo "FAIL ($SYS_MODULE is missing)"
		return 1
	fi

	# Allow a userspace device manager a short time to create the node.
	for attempt in 1 2 3; do
		if manager_ready; then
			echo "OK"
			return 0
		fi
		sleep 1
	done

	echo "FAIL ($MANAGER_DEVICE is missing)"
	return 1
}

stop()
{
	printf 'Stopping PDM: '
	module_loaded || { echo "OK (not loaded)"; return 0; }

	# The AM62x RS485 serdev close path can sleep in the OMAP8250 runtime-PM
	# shutdown callback while modprobe is removing PDM. Keep the driver and its
	# buses alive until reset; rcK sets this marker before stopping services.
	if [ -e /run/shutdown ]; then
		echo "OK (kept loaded for reboot)"
		return 0
	fi

	# A terminated process may still be releasing its device file descriptors.
	for attempt in 1 2 3; do
		if modprobe -r "$MODULE"; then
			echo "OK"
			return 0
		fi
		[ "$attempt" -eq 3 ] || sleep 1
	done
	echo "FAIL (module still in use; keeping CAN up)"
	[ ! -r "$SYS_MODULE/refcnt" ] || { printf 'PDM reference count: '; cat "$SYS_MODULE/refcnt"; }
	for fd in /proc/[0-9]*/fd/*; do
		target=$(readlink "$fd" 2>/dev/null) || continue
		case "$target" in
			/dev/pdm/*|/dev/pdm_manager|/sys/kernel/debug/pdm/*)
				echo "PDM holder: $fd -> $target" ;;
		esac
	done
	return 1
}

status()
{
	if module_loaded && manager_ready; then
		echo "PDM: loaded, $MANAGER_DEVICE ready"
		return 0
	fi

	module_loaded && echo "PDM: loaded, $MANAGER_DEVICE missing" || \
		echo "PDM: not loaded"
	return 3
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		stop && start
		;;
	status)
		status
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload|status}" >&2
		exit 2
		;;
esac
