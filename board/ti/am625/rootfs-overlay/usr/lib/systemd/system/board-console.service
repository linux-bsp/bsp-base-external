[Unit]
Description=Board debug serial console
After=systemd-user-sessions.service
Conflicts=serial-getty@ttyS2.service

[Service]
Type=idle
ExecStart=/bin/sh -l
Restart=always
RestartSec=1
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS2
TTYReset=yes
TTYVHangup=yes
KillMode=control-group

[Install]
WantedBy=multi-user.target
