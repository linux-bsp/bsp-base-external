#!/bin/sh

# Diagnostic output only: never update metadata or gate boot confirmation.

case "$1" in
    start|restart|reload)
        if ! /usr/sbin/fwctl hwid show; then
            echo "[fwctl] [ERROR] device HWID unavailable" >&2
        fi
        if ! /usr/sbin/fwctl --config "${FWCTL_CONFIG:-/etc/edk/system.conf}" version; then
            echo "[fwctl] [ERROR] running firmware version unavailable" >&2
        fi
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload}" >&2
        exit 2
        ;;
esac

exit 0
