/dts-v1/;

/ {
	description = "TI AM62x root filesystem";

	images {
		rootfs {
			description = "Buildroot root filesystem";
			type = "firmware";
			arch = "arm64";
			os = "linux";
			compression = "none";
			hash-1 { algo = "sha256"; };
		};
	};

	configurations {
		default = "conf-1";
		conf-1 {
			description = "TI AM62x root filesystem";
			fw,type = "rootfs";
            fw,hwids = @FW_HWIDS@;
			fw,version = <1>;
			fw,rollback-index = <0>;
			fw,build-time-minutes = <@FW_BUILD_TIME_MINUTES@>;
			firmware = "rootfs";
		};
	};
};
