/dts-v1/;

/ {
	description = "TI AM62x firmware release";

	images {
		manifest {
			description = "TI AM62x release manifest";
			data = "TI AM62x OTA kernel and rootfs release";
			type = "firmware";
			arch = "arm64";
			compression = "none";
			hash-1 { algo = "sha256"; };
		};
	};

	configurations {
		default = "conf-1";

		conf-1 {
			description = "TI AM62x firmware release";
			fw,type = "release";
            fw,hwids = "1010001000110000";
			fw,version = <1>;
			fw,rollback-index = <0>;
            fw,tag = "@FW_TAG@";
            fw,firmware-id = "@FW_ID@";
            fw,kernel-payload-bytes = <@FW_KERNEL_BYTES@>;
            fw,rootfs-payload-bytes = <@FW_ROOTFS_BYTES@>;
            fw,kernel-payload-sha256 = "@FW_KERNEL_PAYLOAD_HASH@";
            fw,rootfs-payload-sha256 = "@FW_ROOTFS_PAYLOAD_HASH@";
			fw,components = "kernel", "rootfs";
			fw,kernel-file = "kernel.itb";
			fw,kernel-sha256 = "@KERNEL_SHA256@";
			fw,rootfs-file = "rootfs.itb";
			fw,rootfs-sha256 = "@ROOTFS_SHA256@";
			firmware = "manifest";
		};
	};
};
